        "id": "I28SH_6stm43",
        "outputId": "f1c0f84e-2e2e-48dc-91e3-882c9991a87f"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Var:  [ 1 40  3  4]\n",
            "Copy:  [1 2 3 4]\n"
          ]
        }
      ],
      "source": [
        "import numpy as np\n",
        "var=np.array([1,2,3,4])\n",
        "\n",
        "co = var.copy()\n",
        "var[1]=40\n",
        "print(\"Var: \",var)\n",
        "print(\"Copy: \",co)\n"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "x=np.array([9,8,7,6,5])\n",
        "\n",
        "vi=x.view()\n",
        "x[1]=40\n",
        "print(\"x: \",x)\n",
        "print(\"View: \",vi)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "Yuqs7J3Murbz",
        "outputId": "062d13ba-d6da-49bb-b2c9-fd67b0aad434"
      },
